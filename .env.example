# Copiez ce fichier en `.env` puis adaptez les valeurs.
# Ne jamais committer de secrets dans le dépôt.

# --- Base de données ---
ENERGY_DB_URL=sqlite:///./app.db

# --- Fuseau horaire ---
ENERGY_TIMEZONE=Europe/Brussels

# --- Elexys ---
ELEXYS_BASE_URL=https://www.elexys.be/fr/insights/quarter-hourly-belpex-day-ahead-spot-be
ELEXYS_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36 EnergyApp/1.0
ELEXYS_TIMEOUT_SECONDS=30
ELEXYS_MAX_RETRIES=4
ELEXYS_BACKOFF_SECONDS=2.0

# --- Répertoire de cache local des pages Elexys ---
ENERGY_CACHE_DIR=./cache

# --- Transformation des prix ---
PRICE_TRANSFORM_A=-17.3
PRICE_TRANSFORM_B=0.3

# --- Import ---
# Taille maximale d'un classeur en octets (50 Mo par défaut)
ENERGY_MAX_FILE_SIZE_BYTES=52428800

# Tolérance : autoriser un prix horaire incomplet (< 4 quarts d'heure) comme prix officiel.
# false = NULL si incomplet (recommandé). true = moyenne disponible utilisée.
ENERGY_ALLOW_INCOMPLETE_PRICE=false
